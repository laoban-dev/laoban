{
  "name": "@laoban/package_details",
  "description": "The types, normalisation and validation for the package.details.json file, which is used to define the details of a package, such as its name, description, links to other packages and managed file enrichments",
  "version": "2.0.0",
  "main": "dist/index",
  "types": "dist/index",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@laoban/errors": "2.0.0",
    "@laoban/observability": "2.0.0",
    "@laoban/safe": "2.0.0",
    "@laoban/validation": "2.0.0",
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@testing-library/jest-dom": "^6.1.4",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/"
  ],
  "keywords": [
    "indexing"
  ],
  "license": "MIT",
  "repository": "git@github.com:phil-rice/laoban.git",
  "scripts": {
    "test": "jest --config jest.config.json --env node",
    "test:watch": "npm run test -- --watch"
  }
}