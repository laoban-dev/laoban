{
  "packageManager": "yarn",
  "parents": [
    "@laoban@/laoban.json/core.laoban.json",
    "@laoban@/laoban.json/javascript.laoban.json",
    "@laoban@/laoban.json/typescript.laoban.json",
    "@laoban@/laoban.json/typescript.publish.laoban.json",
    "@laoban@/laoban.json/react.laoban.json"
  ],
  "templates": {
    "typescript": "templates/typescript",
    "node": "templates/node"
  },
  "properties": {
    "types_node": "^25.6.0",
    "license": "MIT",
    "repository": "git@github.com:phil-rice/laoban.git"
  },
  "scripts": {
    "pwd": {
      "description": "Shows the pwd",
      "inLinksOrder": true,
      "commands": [
        {
          "name": "test",
          "command": "js:process.cwd()"
        }
      ]
    },
    "threethings": {
      "description": "Executes three commands for tests",
      "commands": [
        "echo one",
        "echo two",
        "echo three"
      ]
    },
    "mvn": {
      "description": "mvn use -- and then specify the maven arguments e.g. laoban mvn -- clean install",
      "inLinksOrder": true,
      "passThruArgs": "the arguments that are passed through to maven",
      "commands": [
        {
          "name": "mvn",
          "command": "echo mvn ${passThruArgs}"
        }
      ]
    }
  },
  "defaultEnv": {
    "TEST_DEFAULT": "test"
  }
}